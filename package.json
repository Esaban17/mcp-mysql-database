  },
  "homepage": "https://github.com/Esaban17/mcp-mysql-database#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "mysql2": "^3.24.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "bin": {
    "mcp-mysql-database": "dist/index.js"
  }
